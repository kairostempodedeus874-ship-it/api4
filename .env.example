# ─────────────────────────────────────────────────────────────────
# Kairós — Servidor de WhatsApp — v5.4.0
# ─────────────────────────────────────────────────────────────────
# Boa notícia: NÃO existe nenhuma variável obrigatória nesta versão.
# O servidor já vem com tudo preenchido: endereço do Backend, chaves
# do painel, pasta da sessão e URL pública são detectados sozinhos.
#
# Ele também NÃO usa a chave de serviço do banco: as consultas passam
# pela função wpp-agente, que já roda com permissão total no Backend.
# Ou seja: nada de copiar chave secreta para o painel da hospedagem.
#
# Renomeie este arquivo para ".env" só se for rodar no seu computador
# ou numa VPS. O conteúdo abaixo já é opcional.
# ─────────────────────────────────────────────────────────────────

# Fuso horário — importante para a cobrança sair às 11h de Brasília.
TZ=America/Sao_Paulo

# ─────────────────────────────────────────────────────────────────
# TUDO ABAIXO É OPCIONAL. Se você apagar estas linhas nada quebra,
# porque o código já usa estes mesmos valores como padrão.
# ─────────────────────────────────────────────────────────────────

# Porta HTTP. Deixe em branco na hospedagem (ela injeta a sua).
# PORT=8080

# Chave que o painel usa para falar com o servidor.
# Padrão: kairos_wpp_2026_7f3b9d2a
# WPP_API_KEY=

# Mesma chave configurada na função wpp-agente (a IA).
# Padrão: kairos_ag_2026_2d8e5b1c
# WPP_AGENT_SECRET=

# Endereço do Backend (Readdy). Já tem padrão apontando para o correto.
# SUPABASE_URL=

# Pasta da sessão do WhatsApp. NÃO precisa preencher:
# o servidor detecta sozinho o disco montado (/var/data, /data, etc.)
# Só use se quiser forçar um caminho específico.
# WPP_AUTH_DIR=

# URL pública do servidor. Detectada sozinha (Render, Fly, Railway).
# WPP_PUBLIC_URL=